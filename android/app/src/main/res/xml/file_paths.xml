<?xml version="1.0" encoding="utf-8"?>
<!-- Шаблонный external-path со всем корнем внешнего хранилища убран. Бэкап уходит своим
     плагином SaveFile через системное окно «Сохранить как». FileProvider отдаёт наружу
     только выгрузку в Excel (1.0.4, ShareFilePlugin): файл в cache/export, право чтения -
     одному приложению, выбранному в окне «Отправить». Путь - только папка export/ в кэше
     (не весь кэш: там лежат и копии WebView, и распакованные обновления). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="export" path="export/" />
</paths>
